{
  "name": "cpr-coach-glasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CPR Coach - Even Realities G2 glasses app (training tool, not a medical device)",
  "scripts": {
    "dev": "vite",
    "fetch-model": "node scripts/fetch-model.mjs",
    "sim": "evenhub-simulator http://localhost:5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && evenhub pack app.json ./dist -o cpr-coach.ehpk",
    "qr": "evenhub qr --port 5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
